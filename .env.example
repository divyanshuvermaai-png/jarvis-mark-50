# ========================================================
# J.A.R.V.I.S. System Configuration Template (.env.example)
# Organization: Divyanshu Industries
# Creator: Divyanshu Verma
# ========================================================
# Copy this file to .env and customize as needed.
# NEVER commit real secret keys, tokens, or credentials to git.

# ── 1. Local Mode Configuration (main.py) ──
PORT=5001
HOST=127.0.0.1

# ── 2. Remote Mode Configuration (main_2.py) ──
JARVIS_REMOTE_HOST=127.0.0.1
JARVIS_REMOTE_PORT=5002
JARVIS_REMOTE_ENABLED=true

# Remote Security Passcode (if unset, loads/generates ~/.jarvis_system/remote_secret.key)
JARVIS_REMOTE_SECRET=your_secure_remote_passcode_here

# ── 3. Session & Security Rate Limiting ──
JARVIS_SESSION_TTL=86400
JARVIS_AUTH_RATE_LIMIT=5

# ── 4. AI & Local Apple Silicon Hardware ──
# Primary Model: Gemma 4 E2B (4-bit MLX) runs 100% locally on Apple Silicon GPU
# GEMINI_API_KEY is an optional cloud fallback for Vision OCR if local MLX vision is unconfigured
GEMINI_API_KEY=
